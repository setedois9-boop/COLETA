# ============================================
# VARIÁVEIS DE AMBIENTE - PONTO DE COLETA
# ============================================

# Porta do Servidor Node.js Express (Padrão: 3001)
PORT=3001

# Segredo criptográfico para assinatura dos tokens JWT da Administração.
# Substitua o valor de exemplo por uma chave aleatória e estável em cada ambiente.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_64_CARACTERES_HEXADECIMAIS

# Chave criptográfica dedicada AES-256-GCM (64 caracteres hexadecimais) para cifragem dos segredos 2FA em repouso
# Se omitida, deriva-se uma chave de 256 bits a partir do JWT_SECRET.
# Defina uma chave própria e estável antes de habilitar o 2FA em produção.
TOTP_ENCRYPTION_KEY=

# Credenciais iniciais de desenvolvimento; substitua por valores fortes em produção.
ADMIN_EMAIL=admin@pontodecoleta.com.br
ADMIN_PASSWORD=Admin@2026

# ============================================
# SUPABASE / POSTGRESQL (OPCIONAL / PRODUÇÃO)
# Se não configurado, o sistema roda com SQLite local automático
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# GOOGLE MAPS PLATFORM (OPCIONAL)
# Se não configurado, o sistema utiliza OpenStreetMap / Leaflet automaticamente
# ============================================
VITE_GOOGLE_MAPS_API_KEY=
