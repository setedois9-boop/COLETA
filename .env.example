# ============================================
# VARIÁVEIS DE AMBIENTE - PONTO DE COLETA
# ============================================

# Porta do Servidor Node.js Express (Padrão: 3001)
PORT=3001

# Segredo criptográfico para assinatura dos tokens JWT da Administração (Gere uma chave hexadecimal aleatória de 64 caracteres)
JWT_SECRET=6c48d88a3273c0ea10957e9dbd2c789784f8541dbf2391bed73c8f54760116bf

# Chave criptográfica dedicada AES-256-GCM (64 caracteres hexadecimais) para cifragem dos segredos 2FA em repouso
# Se omitida, deriva-se automaticamente uma chave de 256 bits a partir do JWT_SECRET
TOTP_ENCRYPTION_KEY=

# Credenciais iniciais do Administrador Geral (Podem ser alteradas pelo painel)
ADMIN_EMAIL=admin@pontodecoleta.com.br
ADMIN_PASSWORD=Admin@2026

# ============================================
# SUPABASE / POSTGRESQL (OPCIONAL / PRODUÇÃO)
# Se não configurado, o sistema roda com SQLite local automático
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# GOOGLE MAPS PLATFORM (OPCIONAL)
# Se não configurado, o sistema utiliza OpenStreetMap / Leaflet automaticamente
# ============================================
VITE_GOOGLE_MAPS_API_KEY=
