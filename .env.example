# ============================================
# VARIÁVEIS DE AMBIENTE - PONTO DE COLETA
# ============================================

# Porta do Servidor Node.js Express (Padrão: 3001)
PORT=3001

# Configure a unique, randomly generated secret on the backend host.
JWT_SECRET=replace-with-a-long-random-secret

# ============================================
# SUPABASE / POSTGRESQL (OPCIONAL)
# Se não configurado, o sistema roda com SQLite local automático
# ============================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# GOOGLE MAPS PLATFORM (OPCIONAL)
# Se não configurado, o sistema utiliza OpenStreetMap / Leaflet automaticamente
# ============================================
VITE_GOOGLE_MAPS_API_KEY=
